# Copy to .env and fill in. Never commit .env or the .pem file.
GITHUB_ORG=your-org
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
# Local dev: path to the App private key, kept OUTSIDE this repo.
GITHUB_PRIVATE_KEY_PATH=C:\Users\you\.secrets\repo-auditor.pem
# In AWS, GITHUB_PRIVATE_KEY is injected from Secrets Manager instead.
# GITHUB_PRIVATE_KEY=

# Corporate SSL inspection: path to the company CA bundle (PEM). It is trusted IN ADDITION
# to the public CAs. Keep it outside this repo. Leave unset where traffic isn't inspected.
# CA_BUNDLE=C:\Users\you\.secrets\corp-ca-bundle.pem

DATABASE_URL=postgresql://auditor:auditor@localhost:5432/auditor

COLLECTOR_CONCURRENCY=8
RATE_LIMIT_FLOOR=500

# --- Metabase (Phase 5): docker compose --profile reports up -d; auditor metabase setup ---
# Host port for Metabase (change if 3000 is taken); keep METABASE_URL in sync.
METABASE_PORT=3000
METABASE_URL=http://localhost:3000
# The Metabase admin account. `auditor metabase setup` creates it on first run.
# Metabase rejects weak/common passwords.
METABASE_ADMIN_EMAIL=you@example.com
METABASE_ADMIN_PASSWORD=
# How Metabase reaches PostgreSQL (read-only login). Defaults match docker-compose.yml.
# METABASE_DB_HOST=db
# METABASE_DB_USER=metabase_reader
# METABASE_DB_PASSWORD=metabase_reader
